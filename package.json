{
  "name": "visilearn",
  "version": "0.1.0",
  "private": true,
  "description": "Visual, interactive learning engine: a tiny scene language rendered as animated, interactive SVG.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "node tools/check.ts",
    "test": "node --test tests/*.test.ts",
    "mcp": "node mcp/server.ts",
    "deploy": "npm run check && npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "alpinejs": "3.17.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/alpinejs": "3.17.0",
    "@types/node": "26.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
